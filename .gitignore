# Root .gitignore

# IDE and Tooling
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Build artifacts (Root level redundancy)
build/
out/
.gradle/

# Backend (Managed by backend/.gitignore, but kept here for safety)
backend/build/
backend/out/
backend/.gradle/
backend/bin/

# Frontend (Managed by frontend/.gitignore, but kept here for safety)
frontend/node_modules/
frontend/dist/
frontend/.temp/
frontend/stats.html

# Environment variables
.env
.env.*.local
*.local
